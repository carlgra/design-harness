#!/bin/sh
#
# Give a project that already exists a design, and a machine that holds the
# code to it.
#
#   ./bootstrap /path/to/project            adopt the method there
#   ./bootstrap --update /path/to/project   replace its harness with this one,
#                                           and the method's rules in CLAUDE.md
#
#   --standalone  give the project a harness of its own even under a root
#   --no-hooks    do not install the git hooks
#   --no-ci       do not write .github/workflows/harness.yml
#
# A PROJECT UNDER A ROOT. Where a directory above the project holds both a
# harness and a design, that directory is a root and the project is one of
# the repositories nested under it: a service, say, beside the contracts
# repository the services talk through. Such a project gets no harness of
# its own. It uses the root's by relative path, its rules say to read the
# root's first, its skeleton takes the root's commit convention and the
# sections the root asks of a note, and what the root decided is cited by the
# root's name. Bootstrap the root first, then each repository inside it.
#
# Otherwise it copies harness/ into the project and then adds only what is missing: a
# design/DESIGN.md whose spine accounts for every file as it stands and whose
# every section is still a question, the first note under design/changes/,
# the method's rules in CLAUDE.md, the CI workflow, and the git hooks. It
# overwrites nothing that exists and commits nothing: what it did is yours to
# read with git status. When it is done the checker passes, and the next step
# is the design itself:
#
#   cd /path/to/project && go -C harness run ./cmd/elephant draft
set -eu

SRC="$(cd "$(dirname "$0")" && pwd)"
UPDATE=0
STANDALONE=0
HOOKS=1
CI=1
TARGET=""
for arg in "$@"; do
  case "$arg" in
    --update) UPDATE=1 ;;
    --no-hooks) HOOKS=0 ;;
    --no-ci) CI=0 ;;
    --standalone) STANDALONE=1 ;;
    -h|--help) sed -n '3,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown option: $arg" >&2; exit 2 ;;
    *) [ -z "$TARGET" ] || { echo "one project at a time" >&2; exit 2; }; TARGET="$arg" ;;
  esac
done

die() { printf '\nbootstrap: %s\n' "$*" >&2; exit 1; }
did() { printf '  %-9s %s\n' "$1" "$2"; }

[ -n "$TARGET" ] || die "name the project: ./bootstrap /path/to/project"
[ -d "$TARGET" ] || die "$TARGET is not a directory"
T="$(cd "$TARGET" && pwd -P)"
[ "$T" != "$(cd "$SRC" && pwd -P)" ] || die "that is this repository; name the project to adopt the method in"
[ -f "$SRC/harness/FRAMEWORK.md" ] || die "$SRC/harness is not the harness; run bootstrap from its own repository"
command -v go >/dev/null 2>&1 || die "the Go toolchain is not installed; the harness is Go, and needs it wherever the checker runs"
command -v git >/dev/null 2>&1 || die "git is not installed"
[ "$(git -C "$T" rev-parse --show-toplevel 2>/dev/null || true)" = "$T" ] || \
  die "$T is not the root of a git repository; the method is one design per repository"

# The harness reaches no workspace: it is a module of its own, whatever the
# project around it is.
export GOWORK=off

NAME="$(basename "$(git -C "$T" remote get-url origin 2>/dev/null || echo "$T")" .git)"
TODAY="$(date +%Y-%m-%d)"
echo "bootstrap: $NAME ($T)"

# --------------------------------------------------------------------------
# Is the project nested under a root? A root is the nearest directory above it
# that holds a design and this harness. UP is the way back to it ("..", or
# "../.." two levels down) and SUB the project's path within it.
ROOT=""; UP=""; SUB=""
if [ "$STANDALONE" -eq 0 ] && [ ! -e "$T/harness" ]; then
  dir="$(dirname "$T")"; up=".."; sub="$(basename "$T")"
  while :; do
    if [ -f "$dir/harness/FRAMEWORK.md" ] && [ -f "$dir/harness/go.mod" ] && [ -f "$dir/design/DESIGN.md" ]; then
      ROOT="$dir"; UP="$up"; SUB="$sub"; break
    fi
    [ "$dir" != "/" ] || break
    sub="$(basename "$dir")/$sub"; up="$up/.."; dir="$(dirname "$dir")"
  done
fi

if [ -n "$ROOT" ]; then
  # Nested: the root's harness, by relative path, and no copy.
  # A nested project has no harness to replace: the root's is updated at
  # the root. --update here refreshes its rules from the root's templates.
  H="$ROOT/harness"
  HREL="$UP/harness"
  PARENT="$(basename "$(git -C "$ROOT" remote get-url origin 2>/dev/null || echo "$ROOT")" .git)"
  CLAUDE_TEMPLATE="CLAUDE.nested.md"
  did nested "under $PARENT: its harness, $HREL, and its rules"
else
  # The harness: the checker, goldfish, elephant, the push script, the hooks,
  # the templates and the method itself. A copy, so that the project depends
  # on nothing outside itself.
  H="$T/harness"
  HREL="harness"
  PARENT=""
  CLAUDE_TEMPLATE="CLAUDE.md"
  if [ -e "$T/harness" ]; then
    [ -f "$T/harness/FRAMEWORK.md" ] || \
      die "$T/harness exists and is not this harness. The harness lives in harness/ at the root; move what is there first."
    if [ "$UPDATE" -eq 1 ]; then
      # The settings are the project's own: its model.
      KEEP="$(mktemp -d)"
      for f in goldfish/goldfish.yaml elephant/elephant.yaml; do
        [ ! -f "$T/harness/$f" ] || { mkdir -p "$KEEP/$(dirname "$f")"; cp "$T/harness/$f" "$KEEP/$f"; }
      done
      rm -rf "$T/harness"
      cp -R "$SRC/harness" "$T/harness"
      cp -R "$KEEP/." "$T/harness/"
      rm -rf "$KEEP"
      did replaced "harness/ (its settings kept)"
    else
      did kept "harness/ (--update replaces it with this one)"
    fi
  else
    cp -R "$SRC/harness" "$T/harness"
    did wrote "harness/"
  fi
  chmod +x "$T/harness/safe-push" "$T/harness/hooks/pre-push" "$T/harness/hooks/commit-msg" "$T/harness/hooks/install"
fi

# A nested project's CI checks the root out around it, so it must know where
# the root is cloned from: GitHub's owner/name, read from the root's origin.
PARENT_REPO=""
if [ -n "$ROOT" ]; then
  PARENT_REPO="$(git -C "$ROOT" remote get-url origin 2>/dev/null | sed -n -e 's#\.git$##' -e 's#^.*github\.com[:/]##p')"
fi

# What a template says of where things are: the project, the harness, and
# for a nested project the root.
fill() {
  sed -e "s|{{NAME}}|$NAME|g" -e "s|{{HARNESS}}|$HREL|g" -e "s|{{PARENT}}|$PARENT|g" \
      -e "s|{{UP}}|$UP|g" -e "s|{{PATH}}|$SUB|g" -e "s|{{PARENT_REPO}}|$PARENT_REPO|g" "$1"
}

# --------------------------------------------------------------------------
# How an agent works here. A CLAUDE.md that exists keeps every line it has;
# the method's rules are added after them, once.
if [ ! -f "$T/CLAUDE.md" ]; then
  fill "$H/templates/$CLAUDE_TEMPLATE" > "$T/CLAUDE.md"
  did wrote "CLAUDE.md"
elif grep -q 'design-harness:begin' "$T/CLAUDE.md"; then
  # THE METHOD'S RULES ARE THE HARNESS'S, AND GO WHERE IT GOES. They were
  # written from a template, between two marks; an update that replaced the
  # harness and left them would leave a project following last year's rules.
  # So --update rewrites what lies between the marks, and nothing outside
  # them: every other line of the file is the project's.
  if [ "$UPDATE" -eq 1 ] && grep -q 'design-harness:end' "$T/CLAUDE.md"; then
    BLOCK="$(mktemp)"
    fill "$H/templates/$CLAUDE_TEMPLATE" | awk '/design-harness:begin/{p=1} p{print} /design-harness:end/{p=0}' > "$BLOCK"
    awk -v block="$BLOCK" '
      /design-harness:begin/ { while ((getline line < block) > 0) print line; skip = 1; next }
      /design-harness:end/   { skip = 0; next }
      !skip                  { print }' "$T/CLAUDE.md" > "$T/CLAUDE.md.new"
    if cmp -s "$T/CLAUDE.md" "$T/CLAUDE.md.new"; then
      rm -f "$T/CLAUDE.md.new"
      did kept "CLAUDE.md (the method's rules are current)"
    else
      mv "$T/CLAUDE.md.new" "$T/CLAUDE.md"
      did replaced "the method's rules in CLAUDE.md, between their marks; every other line kept"
    fi
    rm -f "$BLOCK"
  else
    did kept "CLAUDE.md"
  fi
else
  { printf '\n## The design, and how a change lands\n\n'; fill "$H/templates/$CLAUDE_TEMPLATE" | sed '1,2d'; } >> "$T/CLAUDE.md"
  did added "the method's rules, at the end of CLAUDE.md"
fi

# --------------------------------------------------------------------------
if [ "$CI" -eq 1 ]; then
  if [ -f "$T/.github/workflows/harness.yml" ]; then
    did kept ".github/workflows/harness.yml"
  elif [ -n "$ROOT" ] && [ -z "$PARENT_REPO" ]; then
    did skipped ".github/workflows/harness.yml: $PARENT has no GitHub origin yet for CI to check out. Run this again when it has."
  else
    mkdir -p "$T/.github/workflows"
    if [ -n "$ROOT" ]; then
      # Where the root's map lists a contracts repository, the checker reads
      # there what this one must serve, so CI checks it out too.
      WHERE="$(go -C "$H" run ./cmd/elephant where -root "$T" 2>/dev/null || true)"
      CPATH="$(printf '%s\n' "$WHERE" | sed -n 's/^contracts_path=//p')"
      CREPO="$(printf '%s\n' "$WHERE" | sed -n 's/^contracts_remote=//p' | sed -n -e 's#\.git$##' -e 's#^.*github\.com[:/]##p')"
      STEP="$(mktemp)"
      if [ -n "$CPATH" ] && [ -n "$CREPO" ]; then
        printf '\n      - name: the contracts repository, beside this one\n        uses: actions/checkout@v4\n        with:\n          repository: %s\n          path: %s\n' "$CREPO" "$CPATH" > "$STEP"
      fi
      fill "$H/templates/harness.nested.yml" | awk -v step="$STEP" '
        /\{\{CONTRACTS_CHECKOUT\}\}/ { while ((getline line < step) > 0) print line; next }
        { print }' > "$T/.github/workflows/harness.yml"
      rm -f "$STEP"
      [ -z "$CPATH" ] || [ -n "$CREPO" ] || CI_NOTE="the root's map lists a contracts repository at $CPATH with no GitHub remote, so the workflow does not check it out and the checker will fail in CI until it does"
    else
      cp "$H/templates/harness.yml" "$T/.github/workflows/harness.yml"
    fi
    did wrote ".github/workflows/harness.yml"
    [ -z "${CI_NOTE:-}" ] || did note "$CI_NOTE"
  fi
fi

# --------------------------------------------------------------------------
# The design, last, so that its spine accounts for everything written above.
# A skeleton: the spine is filled from a survey of what is there, so the
# checker passes at once; the body is questions.
mkdir -p "$T/design/changes"
if [ -f "$T/design/DESIGN.md" ]; then
  did kept "design/DESIGN.md"
else
  go -C "$H" run ./cmd/elephant skeleton -root "$T" >/dev/null
  did wrote "design/DESIGN.md (a skeleton)"
  for n in "$T"/design/changes/*-adopt-the-design.md; do
    [ ! -f "$n" ] || did wrote "design/changes/$(basename "$n")"
  done
fi

# --------------------------------------------------------------------------
if [ "$HOOKS" -eq 1 ]; then
  if (cd "$T" && "$H/hooks/install" >/dev/null 2>&1); then
    did installed "the pre-push and commit-msg hooks"
  else
    did skipped "the git hooks: this repository already has hooks. Run $HREL/hooks/install to see how to keep both."
  fi
fi

# --------------------------------------------------------------------------
echo
go -C "$H" run ./cmd/check -root "$T" -validate=false || {
  echo
  echo "bootstrap: the checker does not pass yet. Each FAIL above is a file the design"
  echo "           does not account for, or a note without its parts: amend design/DESIGN.md."
}
[ ! -f "$T/go.work" ] || {
  echo
  echo "bootstrap: this project has a go.work. The scripts and hooks set GOWORK=off for the"
  echo "           harness; typed by hand, a harness command needs it too, or ./harness in go.work."
}

if [ -n "$ROOT" ]; then
  REMOTE="$(git -C "$T" remote get-url origin 2>/dev/null || true)"
  echo
  echo "bootstrap: $NAME is nested under $PARENT. Two things there are yours to do, in $ROOT:"
  echo
  echo "  1. Put it on the map: under repos: in the frontmatter of design/DESIGN.md,"
  echo
  echo "         repos:"
  echo "           - path: $SUB"
  echo "             kind: service"
  [ -z "$REMOTE" ] || echo "             remote: $REMOTE"
  echo
  echo "     (kind is the root's own word for it: service, contracts, platform.)"
  echo
  echo "  2. Keep its files out of the root's history: add  /$SUB/  to .gitignore."
fi

cat <<EOF

bootstrap: done. Nothing is committed; read what changed with:  git -C $T status

Next, in $T:

  1. Draft the design from the code. One session reads the repository and
     writes nothing itself; what it could not find it marks (inferred) or
     TODO(elephant):

         go -C $HREL run ./cmd/elephant draft

     Or hand the same instructions to an agent of your own:

         go -C $HREL run ./cmd/elephant prompt

  2. Read design/DESIGN.md, all of it, and answer every mark. This is the
     step that makes it the design. Switch on validate: in its frontmatter
     when the command it names passes.

  3. Ask a session with no memory whether it can explain the repository from
     the document alone, and mend what it could not:

         go -C $HREL run ./cmd/goldfish -only comprehension

  4. Commit on a branch and push through the one door:

         git checkout -b feat/adopt-the-design
         git add -A && git commit -m "design: this repository has a design, and a machine holds the code to it"
         $HREL/safe-push

The method itself is in $HREL/FRAMEWORK.md.
EOF
